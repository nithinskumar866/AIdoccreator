# Copy this file to .env and add your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: a model your key can use
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_RETRIES=5
# GEMINI_REQUESTS_PER_MINUTE=10

# Optional: where it runs
# PORT=10000
# DOCUMENTOR_DATA_DIR=data
# DOCUMENTOR_MAX_UPLOAD_MB=25

# There is no login. Leave this off unless every person on the network may use your documents and quota.
# DOCUMENTOR_HOST=127.0.0.1
# DOCUMENTOR_ALLOW_REMOTE=0
